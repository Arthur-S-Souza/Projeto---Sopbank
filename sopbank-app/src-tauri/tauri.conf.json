{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SopBank",
  "version": "1.0.0",
  "identifier": "com.sopbank.finance",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SopBank — Controle Financeiro",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Controle de gastos, entradas e cartões de crédito",
    "longDescription": "SopBank é um aplicativo desktop para gerenciar finanças pessoais: entradas, saídas, contas bancárias, cartões de crédito e compras parceladas.",
    "category": "Finance",
    "copyright": "© 2026 SopBank"
  }
}
